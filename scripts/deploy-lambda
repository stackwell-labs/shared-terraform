#!/usr/bin/env python3
"""deploy-lambda: deploy a Rust Lambda service from the box (shared-terraform#11).

One engine for every box-deployed Lambda service, in place of each repo's own
deploy-live.sh and build-lambda.sh. A repo describes its deploy targets in
.amber/deploy.toml; the engine owns the safety steps, so every service gets
them by construction:

  1. the credentials are for the target's account;
  2. the tree is clean and HEAD is on origin/main (--break-glass skips the
     origin/main half, for an outage that stops a fix landing:
     agent-platform--protocols#106);
  3. the repo's prebuild hook (if any) runs, and the tree is still clean;
     each bin is built (cargo, x86_64 musl) and zipped reproducibly, with
     the files its include names beside bootstrap (shared-terraform#14);
     a target with no bins is Terraform-only and skips the build and step 5
     (shared-terraform#13);
  4. terraform plans (with the repo's plan_env hook's variables, if any), the
     plan deletes nothing (a replace only of an address listed in
     allow_replace, a plain delete only of an address this run names with
     --allow-delete: shared-terraform#18), the repo's plan_check hook (if any)
     accepts it, and exactly that plan is applied;
  5. each function runs the zip built here and names this commit (a bin may
     name several functions, all running its one zip: shared-terraform#15),
     both $LATEST and, where the function has the alias `current`, the
     version that alias serves (shared-terraform#19);
  6. the repo's smoke hook passes;
  7. a target that names its probe puts one event on the probes account's
     probes-deploys bus, so that service's probe mission runs within minutes
     (shared-terraform#21, probes#20);
  8. each function with the alias `current` keeps its newest KEEP_VERSIONS
     published versions and any an alias names; the older ones are deleted,
     so versions don't pile up one per apply (shared-terraform#20).

Run it from anywhere inside the service repo:

  python3 -I <(git -C ~/agent-platform/shared-terraform show \
    origin/main:scripts/deploy-lambda) <target> [--allow-delete <address>]...
    [--break-glass]

The manifest pins the engine: `engine` is a shared-terraform commit on
origin/main. Whatever copy is invoked hands off to the pinned commit's copy,
read from the shared-terraform clone's git objects (never its working tree,
which nothing keeps current), so a repo deploys with the engine it was tested
with until it moves the pin. README.md ("deploy-lambda") documents the
manifest.

Python stdlib only (3.11+, for tomllib), so the pinned copy runs straight out
of `git show` with no build step.
"""

import argparse
import base64
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib
import zipfile
from pathlib import Path

MANIFEST = ".amber/deploy.toml"
PINNED_ENV = "DEPLOY_LAMBDA_PINNED"
# The box's shared-terraform clone; devbox-fetch keeps its origin current.
SHARED_TERRAFORM = Path(os.environ.get("DEPLOY_LAMBDA_SHARED_TERRAFORM",
                                       Path.home() / "agent-platform" / "shared-terraform"))
RUST_TARGET = "x86_64-unknown-linux-musl"
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
ACCOUNT_RE = re.compile(r"^[0-9]{12}$")
ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
# plan_env may not set these: they decide which account terraform acts in and
# what it does, which the engine owns.
ENGINE_ENV_PREFIXES = ("AWS_", "TF_")
TARGET_FIELDS = {
    "account": str,
    "profile": str,
    "region": str,
    "infra": str,
    "var_file": str,
    "cargo_manifest": str,
    "bins": dict,
    "allow_replace": list,
    "smoke": str,
    "plan_env": str,
    "plan_check": str,
    "prebuild": str,
    "probe": str,
}
OPTIONAL_TARGET_FIELDS = {"var_file", "allow_replace", "plan_env", "plan_check",
                          "prebuild", "cargo_manifest", "bins", "probe"}
BIN_FIELDS = {"zip_var": str, "function_outputs": list, "include": dict}
OPTIONAL_BIN_FIELDS = {"include"}
# A zip entry's timestamp: the earliest a zip can hold, so the zip's bytes
# depend only on the files it carries.
ZIP_EPOCH = (1980, 1, 1, 0, 0, 0)
BOOTSTRAP = "bootstrap"
# The alias rust-lambda-service (v0.18.0+) serves through: its
# aws_lambda_alias.current, output as lambda_alias_name (shared-terraform#9).
SERVING_ALIAS = "current"
# Published versions a function keeps, newest first, besides any an alias
# names: enough to move the alias back a few deploys. Each apply publishes
# one, and the account's code storage is capped (shared-terraform#20).
KEEP_VERSIONS = 5
# The probes account's bus a live deploy puts its event on (probes#20, probes
# infra/deploy.tf). Its policy lets each service's account put only its own
# DetailType (the target's `probe`), with this source.
PROBES_BUS = "arn:aws:events:us-east-1:774098479672:event-bus/probes-deploys"
PROBES_SOURCE = "stackwell.deploy"


class Refusal(Exception):
    pass


def say(msg):
    print(f"deploy-lambda: {msg}", flush=True)


def run(args, *, cwd=None, env=None, capture=False):
    """Run a command; a non-zero exit refuses the deploy."""
    out = subprocess.run(
        args,
        cwd=cwd,
        env=env,
        stdout=subprocess.PIPE if capture else None,
        text=True,
    )
    if out.returncode != 0:
        raise Refusal(f"`{' '.join(args)}` exited {out.returncode}")
    return out.stdout if capture else None


# --- the manifest ---------------------------------------------------------


def load_manifest(repo):
    """The manifest and its pinned engine. Only `engine` is checked here: the
    rest is the pinned engine's schema, which an older pin may not share, so
    target_of() checks it in the copy that runs (shared-terraform#16)."""
    path = repo / MANIFEST
    if not path.is_file():
        raise Refusal(f"no {MANIFEST} in {repo}")
    with path.open("rb") as f:
        doc = tomllib.load(f)
    engine = doc.get("engine")
    if not isinstance(engine, str) or not SHA_RE.match(engine):
        raise Refusal(f"{MANIFEST}: engine must be a 40-hex shared-terraform commit")
    return doc, engine


def target_of(doc, target):
    targets = {k: v for k, v in doc.items() if k != "engine"}
    for name, value in targets.items():
        if not isinstance(value, dict):
            raise Refusal(f"{MANIFEST}: unknown top-level key {name!r}")
    if target not in targets:
        raise Refusal(
            f"{MANIFEST} has no target {target!r} (it has: {', '.join(sorted(targets)) or 'none'})"
        )
    return validate_target(target, targets[target])


def check_fields(where, table, fields, optional):
    unknown = set(table) - set(fields)
    if unknown:
        raise Refusal(f"{where}: unknown field(s) {', '.join(sorted(unknown))}")
    for field, kind in fields.items():
        if field not in table:
            if field in optional:
                continue
            raise Refusal(f"{where}: missing {field}")
        if not isinstance(table[field], kind) or (kind is str and not table[field]):
            raise Refusal(f"{where}: {field} must be a non-empty {kind.__name__}")


def validate_target(name, t):
    where = f"{MANIFEST} [{name}]"
    check_fields(where, t, TARGET_FIELDS, OPTIONAL_TARGET_FIELDS)
    if not ACCOUNT_RE.match(t["account"]):
        raise Refusal(f"{where}: account must be a 12-digit AWS account id")
    # A target has bins and a cargo_manifest to build them, or neither: then it
    # is Terraform-only. One spelling for that, so an empty bins table (a typo
    # away from a forgotten [x.bins.y]) is refused rather than taken as it.
    if "bins" in t and not t["bins"]:
        raise Refusal(f"{where}: bins is empty (omit bins and cargo_manifest "
                      "for a Terraform-only target)")
    if ("bins" in t) != ("cargo_manifest" in t):
        raise Refusal(f"{where}: bins and cargo_manifest go together "
                      "(both, or neither for a Terraform-only target)")
    outputs = []
    for bin_name, b in t.setdefault("bins", {}).items():
        if not isinstance(b, dict):
            raise Refusal(f"{where}: bins.{bin_name} must be a table")
        if "function_output" in b:
            raise Refusal(f"{where} bins.{bin_name}: function_output is now "
                          "function_outputs, a list (shared-terraform#15)")
        check_fields(f"{where} bins.{bin_name}", b, BIN_FIELDS, OPTIONAL_BIN_FIELDS)
        fns = b["function_outputs"]
        if not fns or not all(isinstance(o, str) and o for o in fns):
            raise Refusal(f"{where} bins.{bin_name}: function_outputs must be a non-empty "
                          "list of the root's output names")
        outputs += fns
        b["include"] = check_include(f"{where} bins.{bin_name}.include",
                                     b.get("include", {}))
    # One function runs one zip: an output listed twice is either redundant or
    # a function checked against two bins' zips, which can never pass.
    twice = sorted({o for o in outputs if outputs.count(o) > 1})
    if twice:
        raise Refusal(f"{where}: function_outputs lists {', '.join(twice)} more than once")
    allow = t.setdefault("allow_replace", [])
    if not all(isinstance(a, str) and a for a in allow):
        raise Refusal(f"{where}: allow_replace must list resource addresses")
    return t


def plain_relative(path):
    """A relative path of plain components: no '', '.', '..', or leading '/'."""
    parts = path.split("/")
    return all(p not in ("", ".", "..") for p in parts) and "\\" not in path


def check_include(where, include):
    """{zip path: repo-relative dir}, each a plain relative path.

    No zip path may be bootstrap or hold it, or nest inside another: each
    file in the zip then comes from exactly one place.
    """
    for zip_dir, src in include.items():
        if not isinstance(src, str) or not plain_relative(src):
            raise Refusal(f"{where}: {zip_dir!r} must name a repo-relative dir "
                          "(no '..', '.', or leading '/')")
        if not plain_relative(zip_dir):
            raise Refusal(f"{where}: zip path {zip_dir!r} must be relative "
                          "(no '..', '.', or leading '/')")
        if zip_dir.split("/")[0] == BOOTSTRAP:
            raise Refusal(f"{where}: zip path {zip_dir!r} would collide with bootstrap")
    dirs = sorted(include)
    for a, b in zip(dirs, dirs[1:]):
        if b.startswith(a + "/"):
            raise Refusal(f"{where}: zip path {b!r} is inside {a!r}")
    return include


# --- pinning --------------------------------------------------------------


def hand_off(repo, engine, argv):
    """Run the pinned engine commit's copy of this script."""
    git = ["git", "-C", str(SHARED_TERRAFORM)]
    if subprocess.run(git + ["cat-file", "-e", f"{engine}^{{commit}}"],
                      stderr=subprocess.DEVNULL).returncode != 0:
        run(git + ["fetch", "--quiet", "origin", "main"])
    if subprocess.run(git + ["merge-base", "--is-ancestor", engine, "origin/main"]).returncode != 0:
        raise Refusal(f"engine {engine} is not a shared-terraform commit on origin/main")
    source = run(git + ["show", f"{engine}:scripts/deploy-lambda"], capture=True)
    with tempfile.NamedTemporaryFile("w", prefix="deploy-lambda-", suffix=".py",
                                     delete=False) as f:
        f.write(source)
    say(f"engine pinned at shared-terraform {engine}")
    env = dict(os.environ, **{PINNED_ENV: engine})
    try:
        return subprocess.run([sys.executable, "-I", f.name, *argv], cwd=repo, env=env).returncode
    finally:
        os.unlink(f.name)


# --- the repo's hooks -----------------------------------------------------


def hook_path(repo, t, field):
    """The target's hook named by field, checked runnable; None if it has none."""
    if field not in t:
        return None
    hook = repo / t[field]
    if not hook.is_file() or not os.access(hook, os.X_OK):
        raise Refusal(f"{field} hook {t[field]} is not an executable file")
    return hook


def hook_env(env, target, t, infra, sha):
    return dict(env, DEPLOY_TARGET=target, DEPLOY_COMMIT=sha,
                DEPLOY_INFRA=str(infra), DEPLOY_REGION=t["region"])


def plan_env(repo, hook, env):
    """The plan_env hook's KEY=value lines, as variables for terraform.

    Values are often secrets (a provider's API key): only the names are ever
    printed, never a value or a line that failed to parse.
    """
    out = run([str(hook)], cwd=repo, env=env, capture=True)
    extra = {}
    for n, line in enumerate(out.splitlines(), 1):
        if not line.strip():
            continue
        name, eq, value = line.partition("=")
        if not eq or not ENV_NAME_RE.match(name):
            raise Refusal(f"plan_env line {n} is not KEY=value (the line is not shown)")
        if name.startswith(ENGINE_ENV_PREFIXES):
            raise Refusal(f"plan_env may not set {name}: the engine owns "
                          + " and ".join(p + "*" for p in ENGINE_ENV_PREFIXES))
        if name in extra:
            raise Refusal(f"plan_env sets {name} twice")
        if not value:
            raise Refusal(f"plan_env sets {name} to an empty value")
        extra[name] = value
    say(f"plan_env sets {', '.join(sorted(extra)) or 'nothing'} for terraform")
    return extra


# --- the steps ------------------------------------------------------------


def check_account(t, env):
    caller = run(["aws", "sts", "get-caller-identity", "--query", "Account",
                  "--output", "text"], env=env, capture=True).strip()
    if caller != t["account"]:
        raise Refusal(f"profile {t['profile']} is account {caller}, not {t['account']}")


def check_clean(repo, what="the checkout"):
    if run(["git", "status", "--porcelain"], cwd=repo, capture=True).strip():
        raise Refusal(f"{what} has uncommitted or untracked changes")


def check_tree(repo, break_glass):
    check_clean(repo)
    sha = run(["git", "rev-parse", "HEAD"], cwd=repo, capture=True).strip()
    if break_glass:
        # No fetch either: during an amber-git or ChirpAuth outage it fails.
        say(f"BREAK-GLASS: not checking that {sha} is on origin/main. Land it on "
            f"main as soon as the gate can take it (amber-git-service "
            f"docs/break-glass.md, §2 step 4), and say so on the outage's issue")
        return sha
    run(["git", "fetch", "--quiet", "origin", "main"], cwd=repo)
    if subprocess.run(["git", "merge-base", "--is-ancestor", sha, "origin/main"],
                      cwd=repo).returncode != 0:
        raise Refusal(f"{sha} is not on origin/main: land it first")
    return sha


def included_files(repo, bin_name, include):
    """[(zip name, file)] for a bin's include, sorted by zip name.

    Each dir must exist (after prebuild) and hold at least one file, and only
    regular files and dirs: a symlink could reach outside the repo, so it is
    refused rather than followed.
    """
    files = []
    for zip_dir, src in include.items():
        root = repo / src
        if root.is_symlink() or not root.is_dir():
            raise Refusal(f"bins.{bin_name}.include: {src} is not a directory")
        found = []
        for dirpath, dirnames, filenames in os.walk(root):
            for name in sorted(dirnames + filenames):
                p = Path(dirpath) / name
                if p.is_symlink() or not (p.is_dir() or p.is_file()):
                    raise Refusal(f"bins.{bin_name}.include: {p.relative_to(repo)} is not "
                                  "a regular file or directory")
            for name in filenames:
                p = Path(dirpath) / name
                found.append((f"{zip_dir}/{p.relative_to(root).as_posix()}", p))
        if not found:
            raise Refusal(f"bins.{bin_name}.include: {src} has no files")
        files += found
    return sorted(files)


def zip_entry(name, mode):
    info = zipfile.ZipInfo(name, date_time=ZIP_EPOCH)
    info.create_system = 3  # unix, so external_attr carries the mode
    info.external_attr = (0o100000 | mode) << 16
    info.compress_type = zipfile.ZIP_DEFLATED
    return info


def write_zip(binary, files, zip_path):
    """bootstrap (mode 0755), then files [(zip name, path)] in order (0644),
    all at a fixed timestamp: the same inputs give the same zip."""
    zip_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = zip_path.with_suffix(".zip.tmp")
    with zipfile.ZipFile(tmp, "w") as z:
        z.writestr(zip_entry(BOOTSTRAP, 0o755), binary.read_bytes(), compresslevel=9)
        for name, path in files:
            z.writestr(zip_entry(name, 0o644), path.read_bytes(), compresslevel=9)
    tmp.replace(zip_path)


def build(repo, target, t, env):
    """Build every bin; return {bin: zip path}."""
    manifest = repo / t["cargo_manifest"]
    # --workspace: look each --bin up in every workspace member, not just the
    # default packages, so a bin from a non-default member builds
    # (shared-terraform#17). Cargo still compiles only the packages that own
    # one of the bins.
    cmd = ["cargo", "build", "--manifest-path", str(manifest), "--workspace",
           "--release", "--locked", "--target", RUST_TARGET]
    for bin_name in t["bins"]:
        cmd += ["--bin", bin_name]
    run(cmd, cwd=repo, env=env)
    # Cargo decides the target dir (CARGO_TARGET_DIR, .cargo/config, the
    # workspace root); ask it rather than guess.
    meta = json.loads(run(["cargo", "metadata", "--manifest-path", str(manifest),
                           "--format-version", "1", "--no-deps"],
                          cwd=repo, env=env, capture=True))
    target_dir = Path(meta["target_directory"])
    zips = {}
    for bin_name, b in t["bins"].items():
        binary = target_dir / RUST_TARGET / "release" / bin_name
        if not binary.is_file():
            raise Refusal(f"cargo built no {binary}")
        files = included_files(repo, bin_name, b["include"])
        zips[bin_name] = target_dir / "deploy-lambda" / target / bin_name / "bootstrap.zip"
        write_zip(binary, files, zips[bin_name])
        extra = f" (+{len(files)} included file(s))" if files else ""
        say(f"built {bin_name} -> {zips[bin_name]}{extra}")
    return zips


def refused_changes(plan, allow_replace, allow_delete):
    """What the plan guard refuses: each delete other than an allowed replace
    or an allowed plain delete, and each allowed delete the plan doesn't make.

    allow_delete is one run's --allow-delete addresses (shared-terraform#18):
    a migration step's deletes, named when it is taken, never a standing
    allowance. Each must be a plain delete in this plan, so a typo or a step
    already taken refuses rather than allowing nothing.
    """
    refused = []
    deleted = set()
    for rc in plan.get("resource_changes") or []:
        actions = rc["change"]["actions"]
        if "delete" not in actions:
            continue
        if actions == ["delete"] and rc["address"] in allow_delete:
            deleted.add(rc["address"])
            continue
        if "create" in actions and rc["address"] in allow_replace:
            continue
        refused.append(f"{rc['address']} ({'+'.join(actions)})")
    refused += [f"{a} (named by --allow-delete, but the plan does not delete it)"
                for a in sorted(set(allow_delete) - deleted)]
    return refused


def plan_and_apply(repo, infra, t, zips, sha, tf_env, check, check_env, work,
                   allow_delete):
    """tf_env is the deploy's env plus plan_env's variables: only terraform sees it."""
    tf = ["terraform", f"-chdir={infra}"]
    run(tf + ["init", "-input=false", "-backend-config=backend.hcl"], env=tf_env)
    plan_file = str(Path(work) / "tfplan")
    cmd = tf + ["plan", "-input=false", f"-out={plan_file}", f"-var=deploy_commit={sha}"]
    if "var_file" in t:
        cmd.append(f"-var-file={t['var_file']}")
    for bin_name, b in t["bins"].items():
        cmd.append(f"-var={b['zip_var']}={zips[bin_name]}")
    run(cmd, env=tf_env)
    plan_json = run(tf + ["show", "-json", plan_file], env=tf_env, capture=True)
    refused = refused_changes(json.loads(plan_json), t["allow_replace"], allow_delete)
    if refused:
        raise Refusal("the plan guard refuses; not applying:\n  " + "\n  ".join(refused))
    for a in sorted(set(allow_delete)):
        say(f"the plan deletes {a}, as --allow-delete allows")
    if check is not None:
        code = subprocess.run([str(check)], cwd=repo, env=check_env, input=plan_json,
                              text=True).returncode
        if code != 0:
            raise Refusal(f"plan_check {t['plan_check']} refused the plan (exit {code}); "
                          "not applying")
    run(tf + ["apply", "-input=false", plan_file], env=tf_env)


def b64_sha256(path):
    return base64.b64encode(hashlib.sha256(path.read_bytes()).digest()).decode()


def lambda_json(args, env):
    """Run an `aws lambda` read; its JSON, or None if Lambda answers
    ResourceNotFoundException. Any other failure refuses."""
    out = subprocess.run(args + ["--output", "json"], env=env, capture_output=True, text=True)
    if out.returncode == 0:
        return json.loads(out.stdout)
    if "(ResourceNotFoundException)" in out.stderr:
        return None
    raise Refusal(f"`{' '.join(args)}` exited {out.returncode}: {out.stderr.strip()}")


def check_config(label, cfg, bin_name, built, sha):
    if cfg.get("CodeSha256") != built:
        raise Refusal(f"{label} runs code {cfg.get('CodeSha256')}, "
                      f"not {bin_name}'s built zip {built}")
    if cfg.get("Description") != f"commit {sha}":
        raise Refusal(f"{label}'s description is {cfg.get('Description')!r}, "
                      f"not 'commit {sha}'")


def check_deployed(infra, t, zips, sha, env):
    """Every function each bin names runs that bin's zip and names this commit:
    $LATEST, and the version its alias `current` serves when it has one.
    Returns the functions that have that alias."""
    aws = ["aws", "lambda", "--region", t["region"]]
    aliased = []
    for bin_name, b in t["bins"].items():
        built = b64_sha256(zips[bin_name])
        for output in b["function_outputs"]:
            fn = run(["terraform", f"-chdir={infra}", "output", "-raw", output],
                     env=env, capture=True).strip()
            run(aws + ["wait", "function-updated-v2", "--function-name", fn], env=env)
            cfg = lambda_json(aws + ["get-function-configuration", "--function-name", fn], env)
            if cfg is None:
                raise Refusal(f"Lambda has no function {fn} (output {output})")
            check_config(fn, cfg, bin_name, built, sha)
            served = serving_version(aws, fn, env)
            if served is None:
                say(f"{fn} runs {bin_name}'s {built} (commit {sha}); "
                    f"no alias {SERVING_ALIAS}, so $LATEST serves")
                continue
            # The version the alias names, not the alias itself: a published
            # version is immutable, so what is read is what the alias serves.
            label = f"{fn}'s alias {SERVING_ALIAS} (version {served})"
            cfg = lambda_json(aws + ["get-function-configuration", "--function-name", fn,
                                     "--qualifier", served], env)
            if cfg is None:
                raise Refusal(f"{label} names a version Lambda does not have")
            check_config(label, cfg, bin_name, built, sha)
            say(f"{fn} runs {bin_name}'s {built} (commit {sha}), "
                f"served by alias {SERVING_ALIAS} (version {served})")
            aliased.append(fn)
    return aliased


def serving_version(aws, fn, env):
    """The version fn's alias `current` serves, or None if fn has no such
    alias (a function not on rust-lambda-service >= v0.18.0)."""
    alias = lambda_json(aws + ["get-alias", "--function-name", fn, "--name", SERVING_ALIAS], env)
    if alias is None:
        return None
    version = alias.get("FunctionVersion")
    if not isinstance(version, str) or not version.isdigit():
        # $LATEST (or anything but a published version) would make the alias
        # no safer than the unqualified function.
        raise Refusal(f"{fn}'s alias {SERVING_ALIAS} serves {version!r}, "
                      "not a published version")
    return version


def stale_versions(versions, aliases):
    """The published versions to delete, oldest first: all but the newest
    KEEP_VERSIONS and those an alias names (as its version, or in its routing
    config's weighted second version). $LATEST is not a published version
    and is never one."""
    published = sorted(int(v["Version"]) for v in versions if v["Version"].isdigit())
    named = set()
    for a in aliases:
        named.add(a["FunctionVersion"])
        named.update((a.get("RoutingConfig") or {}).get("AdditionalVersionWeights") or {})
    return [str(v) for v in published[:-KEEP_VERSIONS] if str(v) not in named]


def prune_versions(t, fns, env):
    """Delete each function's stale versions (shared-terraform#20).

    Only functions with the alias `current` (rust-lambda-service v0.18.0+,
    which publishes a version per apply), and only once the deploy has passed
    its checks and smoke hook, so a failed deploy keeps every version to roll
    back to.
    """
    aws = ["aws", "lambda", "--region", t["region"]]
    for fn in fns:
        versions = lambda_json(aws + ["list-versions-by-function", "--function-name", fn], env)
        aliases = lambda_json(aws + ["list-aliases", "--function-name", fn], env)
        if versions is None or aliases is None:
            raise Refusal(f"Lambda has no function {fn} to prune")
        stale = stale_versions(versions["Versions"], aliases["Aliases"])
        for v in stale:
            # capture: the CLI prints {"StatusCode": 204} for each one.
            run(aws + ["delete-function", "--function-name", fn, "--qualifier", v], env=env,
                capture=True)
        say(f"{fn}: deleted {len(stale)} old version(s)"
            + (f" ({', '.join(stale)})" if stale else "")
            + f"; kept the newest {KEEP_VERSIONS} and any an alias names")


def put_probe_event(t, sha, env):
    """Put the deploy's event on the probes-deploys bus, so the probe service
    t names runs its mission against this commit (shared-terraform#21).

    With the target's own profile: the bus admits each service's account for
    its own DetailType only. A put the bus doesn't take refuses."""
    entry = {"EventBusName": PROBES_BUS, "Source": PROBES_SOURCE,
             "DetailType": t["probe"], "Detail": json.dumps({"commit": sha})}
    region = PROBES_BUS.split(":")[3]
    out = json.loads(run(["aws", "events", "put-events", "--region", region,
                          "--entries", json.dumps([entry]), "--output", "json"],
                         env=env, capture=True))
    entries = out.get("Entries") or []
    if out.get("FailedEntryCount") != 0 or len(entries) != 1 or not entries[0].get("EventId"):
        raise Refusal(f"probes-deploys did not take the {t['probe']!r} event: {json.dumps(out)}")
    say(f"put the {t['probe']!r} probe event for {sha} on probes-deploys "
        f"(event {entries[0]['EventId']})")


def smoke(repo, hook, target, t, infra, sha, env):
    run([str(hook)], cwd=repo, env=hook_env(env, target, t, infra, sha))


def deploy(repo, target, t, allow_delete, break_glass):
    env = dict(os.environ, AWS_PROFILE=t["profile"])
    infra = (repo / t["infra"]).resolve()
    env_hook = hook_path(repo, t, "plan_env")
    check = hook_path(repo, t, "plan_check")
    prebuild = hook_path(repo, t, "prebuild")
    smoke_hook = hook_path(repo, t, "smoke")
    check_account(t, env)
    sha = check_tree(repo, break_glass)
    say(f"deploying {sha} to {target} (account {t['account']})")
    repo_env = hook_env(env, target, t, infra, sha)
    tf_env = dict(env, **plan_env(repo, env_hook, repo_env)) if env_hook else env
    if prebuild is not None:
        run([str(prebuild)], cwd=repo, env=repo_env)
        # What it writes must be ignored, so what deploys is still this commit.
        check_clean(repo, f"after prebuild {t['prebuild']}, the checkout")
    if t["bins"]:
        zips = build(repo, target, t, env)
    else:
        say(f"{target} has no bins: Terraform only, nothing to build")
        zips = {}
    with tempfile.TemporaryDirectory(prefix="deploy-lambda-") as work:
        plan_and_apply(repo, infra, t, zips, sha, tf_env, check, repo_env, work,
                       allow_delete)
    aliased = check_deployed(infra, t, zips, sha, env)
    smoke(repo, smoke_hook, target, t, infra, sha, env)
    say(f"{sha} is live on {target}")
    if "probe" in t:
        try:
            put_probe_event(t, sha, env)
        except Refusal as e:
            raise Refusal(f"{sha} is live on {target}, but its probe event failed "
                          f"(no probe run; old versions not pruned): {e}")
    try:
        prune_versions(t, aliased, env)
    except Refusal as e:
        raise Refusal(f"{sha} is live on {target}, but pruning old versions failed: {e}")


def parse_args(argv):
    p = argparse.ArgumentParser(prog="deploy-lambda")
    p.add_argument("target", help="a table in .amber/deploy.toml")
    p.add_argument("--allow-delete", metavar="ADDRESS", action="append", default=[],
                   help="let this run's plan delete ADDRESS (a resource address, "
                        "e.g. 'module.svc.aws_lambda_function_url.this[0]'), which "
                        "it must; repeat for each")
    p.add_argument("--break-glass", action="store_true",
                   help="deploy HEAD without checking it is on origin/main, when an "
                        "outage of amber-git, amber-ci or ChirpAuth stops a fix "
                        "landing; every other check stays (amber-git-service "
                        "docs/break-glass.md)")
    args = p.parse_args(argv)
    if not all(args.allow_delete):
        p.error("--allow-delete needs a resource address")
    return args


def main(argv):
    args = parse_args(argv)
    try:
        repo = Path(run(["git", "rev-parse", "--show-toplevel"], capture=True).strip())
        doc, engine = load_manifest(repo)
        if os.environ.get(PINNED_ENV) != engine:
            return hand_off(repo, engine, argv)
        deploy(repo, args.target, target_of(doc, args.target), args.allow_delete,
               args.break_glass)
        return 0
    except Refusal as e:
        print(f"deploy-lambda: refusing: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
